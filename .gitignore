# Build outputs
source/sdl/build/
source/sdl/build-release/
source/sdl/build-wasm/
source/dc/build/

# Object files and compiled binaries
*.o
*.elf
*.cdi

# Dreamcast build artifacts (regenerated by the build)
source/dc/1ST_READ.BIN
source/dc/sonicr.bin

# Prebuilt Windows EXE — distributed as a GitHub Release asset, not committed
windows/*.exe

# Local / generated config
SONICR.INF
update-repo.sh

# Local exports generated from user-supplied Sonic R data
exports/

# Local InstallShield extraction and preview scratch data
.tmp-*

# Python bytecode generated while running the exporter/tests
__pycache__/
*.py[cod]

# OS / editor cruft
.DS_Store
